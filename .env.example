# Nusxa olib `.env` deb saqlang va qiymatlarni o'z muhitingizga moslang.
# Bu fayl git'da saqlanadi, `.env` esa saqlanmaydi (`.gitignore` ga qarang).

# Backend API manzili (oxirida "/" bo'lmasin).
#
# `web/src/lib/api/client.ts` va `files.ts` shu manzilga tayanadi. Sozlanmasa
# barcha so'rovlar `ApiError` bilan tugaydi va sahifalar bo'sh holatda chiqadi.
#
# Prefiks `NEXT_PUBLIC_` bo'lgani uchun qiymat brauzer bundle'iga ham tushadi —
# bu yerga MAXFIY ma'lumot (token, parol, kalit) yozmang.
NEXT_PUBLIC_API_BASE_URL=https://api.smart-inklyuziv.uz
